# Supabase — copy from your project's API settings
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI — for the extraction service (Phase 1: client-side only)
# WARNING: EXPO_PUBLIC_ values are embedded in the client bundle.
# Move this to a Supabase Edge Function before shipping to production.
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key-here
